# ==============================================================================
# Video / Audio / Image Binary Assets
# ==============================================================================
# Video
*.mp4
*.mkv
*.mov
*.avi
*.webm
*.flv
*.wmv
*.m4v
*.mpg
*.mpeg

# Audio
*.mp3
*.wav
*.flac
*.ogg
*.m4a
*.aac
*.wma
*.opus

# Images (keep vector .svg source assets outside render caches)
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.bmp
*.ico
*.tif
*.tiff
*.psd
*.heic
*.avif

# ==============================================================================
# Documents, 3D Models, Fonts, Archives & Other Binaries
# ==============================================================================
*.pdf
*.ply
*.obj
*.fbx
*.glb
*.gltf
*.img
*.raw
*.bin
*.dat
*.iso
*.ttf
*.otf
*.woff
*.woff2
*.zip
*.tar
*.gz
*.bz2
*.xz
*.7z
*.rar
*.exe
*.dll
*.so
*.dylib
*.pyd
*.whl

# ==============================================================================
# Manim Render Outputs, Build Artifacts, Audio Outputs & Backups
# ==============================================================================
media/
media_*/
build/
build_*/
audio/
audio_*/
voice_samples/
backup_*/

# Scraped raw HTML snapshots (avoid repo bloat and third-party key false positives)
**/raw/*.html
**/raw/**/*.html

# ==============================================================================
# Logs & Temporary Files
# ==============================================================================
*.log
*.err
*.tmp
*.bak
*.swp
*.swo

# ==============================================================================
# Python & Environment Caches
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/

# ==============================================================================
# OS & IDE
# ==============================================================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
